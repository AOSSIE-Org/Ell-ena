# Copy to dart_defines.json and fill in real client values.
# Never put SUPABASE_SERVICE_ROLE_KEY or VEXA_API_KEY here — those are server-only.
#
# Usage:
#   cp dart_defines.example.json dart_defines.json
#   flutter run --dart-define-from-file=dart_defines.json
#   flutter build appbundle --release --dart-define-from-file=dart_defines.json

SUPABASE_URL=<YOUR_SUPABASE_URL>
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
OAUTH_REDIRECT_URL=io.supabase.ellena://login-callback/

# Server-only (Edge Functions / Supabase secrets — do NOT put in dart_defines.json):
# SUPABASE_SERVICE_ROLE_KEY=
# VEXA_API_KEY=
# SUPABASE_DB_URL=
